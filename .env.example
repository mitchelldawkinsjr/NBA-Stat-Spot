# Database Configuration
# PostgreSQL connection string for production
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://nba_props_user:nba_props_password@postgres:5432/nba_props

# Environment
# Set to 'production' for production deployment
ENV=production
PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Example: https://yourdomain.com,https://www.yourdomain.com,https://username.github.io
# Leave empty to require explicit configuration (recommended for production)
CORS_ORIGINS=

# NBA API Configuration (optional)
# API key for API-Sports.io Basketball API
# Get your key from: https://api-sports.io/documentation/nba/v2
API_NBA_KEY=
API_NBA_USE_RAPIDAPI=false
API_NBA_RATE_LIMIT_PER_MINUTE=10
API_NBA_RATE_LIMIT_PER_DAY=100

# ESPN API Rate Limits (optional overrides)
# Default values are already reasonable, only override if needed
ESPN_RATE_LIMIT_PER_MINUTE=100
ESPN_RATE_LIMIT_PER_HOUR=1000

# Redis Configuration (optional)
# If Redis is available, it will be used for caching
# Leave empty to use SQLite-based caching only
REDIS_URL=

# Logging
# Set log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
